{
  "manifest_version": 3,
  "name": "StrideCast",
  "version": "0.10.0",
  "description": "Shows live cross-trainer stats from StrideCast on top of YouTube, YouTube Music, Teams recordings, WhatsApp Web and the Prusa printer pages, and takes voice commands for a local model.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://stridecast-pi2w.local:3000/*",
    "http://192.168.178.165:3000/*",
    "http://127.0.0.1:3700/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://*.sharepoint.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://web.whatsapp.com/*",
    "https://connect.prusa3d.com/*",
    "http://prusa-core-one.fritz.box/*",
    "http://192.168.178.117/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StrideCast: switch between bar, panel and hidden (Alt+S)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://web.whatsapp.com/*",
        "https://connect.prusa3d.com/*",
        "http://prusa-core-one.fritz.box/*",
        "http://192.168.178.117/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://web.whatsapp.com/*",
        "https://connect.prusa3d.com/*",
        "http://prusa-core-one.fritz.box/*",
        "http://192.168.178.117/*",
        "http://127.0.0.1:3700/tv*",
        "http://stridecast-pi2w.local:3000/tv*",
        "http://192.168.178.165:3000/tv*"
      ],
      "js": [
        "voice.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/stats.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://web.whatsapp.com/*",
        "https://connect.prusa3d.com/*",
        "http://prusa-core-one.fritz.box/*",
        "http://192.168.178.117/*"
      ]
    }
  ]
}

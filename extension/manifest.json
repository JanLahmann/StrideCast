{
  "manifest_version": 3,
  "name": "StrideCast",
  "version": "0.5.3",
  "description": "Shows live cross-trainer stats from StrideCast on top of YouTube, YouTube Music and Teams recordings.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://stridecast-pi2w.local:3000/*",
    "http://192.168.178.165:3000/*",
    "http://127.0.0.1:3700/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StrideCast: switch between bar, panel and hidden (Alt+S)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/stats.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ]
    }
  ]
}

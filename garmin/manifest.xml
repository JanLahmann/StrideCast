<?xml version="1.0"?>
<!-- StrideCast for Garmin watches: reads the ELYX values from the bridge over Bluetooth and
     records a cross-trainer (elliptical) workout with wrist heart rate. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="93e2e527-9e0d-4b93-8d37-dabaacf00ce3" type="watch-app" name="@Strings.AppName"
        entry="StrideCastApp" version="0.1.2" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="FitContributor"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
